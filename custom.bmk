# Example options

# ** compiler optimisation **
#setccopt optimization -O3

# ** specific architecture **
#setwin32ccopt arch -march=pentium3

#setmacx86ccopt arch -march=nocona
#setmacx86ccopt math -msse3

# ** Emscripten (WebAssembly) **
# Activate an emsdk release first. With emsdk_env.sh sourced, emcc, em++, and
# emar are found on PATH. For a fixed SDK installation, uncomment these three
# options and replace the path with the active emsdk/upstream/emscripten path.
#addoption emscripten.js.gcc "/PATH/TO/emsdk/upstream/emscripten/emcc"
#addoption emscripten.js.gpp "/PATH/TO/emsdk/upstream/emscripten/em++"
#addoption emscripten.js.ar "/PATH/TO/emsdk/upstream/emscripten/emar"

# ** iOS configuration **
# Xcode is discovered through xcrun, so no SDK path is required.
# arm64 defaults to iphoneos; select iphonesimulator for Apple-silicon Simulator builds.
#addoption ios.sdk "iphonesimulator"
# Deployment targets default to the selected Xcode SDK's minimum. Uncomment to
# require a newer target for all builds on this installation.
#addoption ios.deployment.target "15.0"
#addoption macos.deployment.target "12.0"
#addoption ios.developer.team "APPLE_TEAM_ID"
# Optional physical device UDID or name. Required only when several are available.
#addoption ios.device "DEVICE_UDID_OR_NAME"

# ** macOS signing **
# Machine-wide fallback identity and profile. Prefer an untracked
# <application>.signing.properties sidecar for application-specific signing.
#addoption macos.signing.identity "Apple Development: Developer Name (APPLE_TEAM_ID)"
#addoption macos.provisioning.profile "/PATH/TO/Mac_Development.provisionprofile"



# ** android configuration **
# ** architecture is determined by build settings **
# ** requires the Gradle template in BlitzMax/resources/android **
# ** custom.bmk is the recommended place for machine-local paths **

#addoption android.java.home "/PATH/TO/JDK-17"
#addoption android.sdk "/PATH/TO/Android/sdk"
#addoption android.ndk.version "28.2.13676358"
#addoption android.platform "21"

# ** Optional SDK target **
#    Defaults to the newest installed Android SDK platform.
#addoption android.sdk.target "35"

# ** Optional adb device serial. Required only when multiple devices are connected. **
#addoption android.device "DEVICE_SERIAL"

# ** Optional Android release signing. **
# Prefer environment variables for passwords in CI, or an untracked
# <application>.signing.properties beside the main source.
#addoption android.signing.keystore "/PATH/TO/upload-keystore.jks"
#addoption android.signing.key.alias "upload"
#addoption android.signing.store.password "keystore-password"
#addoption android.signing.key.password "key-password"

# ** Raspberry Pi Pico configuration **
# Values in custom.bmk take precedence over environment variables and PATH.
# Executable values may name either the executable itself or its containing folder.

#addoption pico.sdk "/PATH/TO/pico-sdk"
#addoption pico.toolchain "/PATH/TO/arm-none-eabi-toolchain"
#addoption pico.cmake "/PATH/TO/cmake"
#addoption pico.ninja "/PATH/TO/ninja"
#addoption pico.picotool "/PATH/TO/picotool"
#addoption pico.pioasm "/PATH/TO/pioasm"
#addoption pico.board.header.dirs "/PATH/TO/CUSTOM/BOARD/HEADERS"
#addoption pico.board.cmake.dirs "/PATH/TO/CUSTOM/BOARD/CMAKE"
#addoption pico.storage "256k"
#addoption pico.float.abi "hard"

# ** ESP32 configuration **
# Values in custom.bmk take precedence over environment variables and PATH.

#addoption esp32.idf "/PATH/TO/esp-idf"
#addoption esp32.target "esp32s3"
#addoption esp32.port "/dev/cu.usbmodem..."
#addoption esp32.board.dirs "/PATH/TO/CUSTOM/ESP32/BOARDS"
