# Example options

# ** compiler optimisation **
#setccopt optimization -O3

# ** specific architecture **
#setwin32ccopt arch -march=pentium3

#setmacx86ccopt arch -march=nocona
#setmacx86ccopt math -msse3



# ** android configuration **
# ** architecture is determined by build settings **
# ** requires the Gradle template in BlitzMax/resources/android **
# ** custom.bmk is the recommended place for machine-local paths **

#addoption android.java.home "/PATH/TO/JDK-17"
#addoption android.sdk "/PATH/TO/Android/sdk"
#addoption android.ndk.version "28.2.13676358"
#addoption android.platform "21"

# ** Optional SDK target **
#    Defaults to the newest installed Android SDK platform.
#addoption android.sdk.target "35"

# ** Optional adb device serial. Required only when multiple devices are connected. **
#addoption android.device "DEVICE_SERIAL"

# ** Raspberry Pi Pico configuration **
# Values in custom.bmk take precedence over environment variables and PATH.
# Executable values may name either the executable itself or its containing folder.

#addoption pico.sdk "/PATH/TO/pico-sdk"
#addoption pico.toolchain "/PATH/TO/arm-none-eabi-toolchain"
#addoption pico.cmake "/PATH/TO/cmake"
#addoption pico.ninja "/PATH/TO/ninja"
#addoption pico.picotool "/PATH/TO/picotool"
#addoption pico.pioasm "/PATH/TO/pioasm"
#addoption pico.board.header.dirs "/PATH/TO/CUSTOM/BOARD/HEADERS"
#addoption pico.board.cmake.dirs "/PATH/TO/CUSTOM/BOARD/CMAKE"
#addoption pico.storage "256k"
#addoption pico.float.abi "hard"

# ** ESP32 configuration **
# Values in custom.bmk take precedence over environment variables and PATH.

#addoption esp32.idf "/PATH/TO/esp-idf"
#addoption esp32.target "esp32s3"
#addoption esp32.port "/dev/cu.usbmodem..."
#addoption esp32.board.dirs "/PATH/TO/CUSTOM/ESP32/BOARDS"
