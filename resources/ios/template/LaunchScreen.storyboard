<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23094" targetRuntime="iOS.CocoaTouch" launchScreen="YES" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="BMX-launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23084"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="BMX-launch-scene">
            <objects>
                <viewController id="BMX-launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="BMX-launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        ${IOS_LAUNCH_IMAGE_VIEW}
                        <viewLayoutGuide key="safeArea" id="BMX-launch-safe-area"/>
                        ${IOS_LAUNCH_BACKGROUND}
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="BMX-launch-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    ${IOS_LAUNCH_IMAGE_RESOURCE}
</document>
